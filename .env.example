# Backend configuration (Cloudflare D1 + R2 + Worker)
VITE_DATA_BACKEND=d1
VITE_IMAGE_STORAGE_PROVIDER=r2
VITE_R2_IMAGE_BASE_URL=/r2
# Worker-only OAuth secrets. Configure with `wrangler secret put`; never expose them to Vite.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Worker-only SMTP settings.
SMTP_HOST=pro218.emailserver.vn
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Thế Giới Trị Mụn
SMTP_FROM_ADDRESS=
SMTP_REPLY_TO=
ADMIN_NOTIFICATION_EMAIL=

# GHTK stays disabled until both token and webhook secret are configured.
GHTK_ENABLED=false
GHTK_TOKEN=
GHTK_WEBHOOK_SECRET=
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_API_KEY=
SEPAY_STATUS_TOKEN_SECRET=
SEPAY_ENABLED=false

# Pancake POS is server-only. The website/D1 remains the source of truth.
PANCAKE_ENABLED=false
PANCAKE_API_KEY=
PANCAKE_SHOP_ID=
PANCAKE_WAREHOUSE_ID=
PANCAKE_API_BASE_URL=https://pos.pages.fm/api/v1
PANCAKE_TIMEOUT_MS=12000
PANCAKE_MAX_ATTEMPTS=8
PANCAKE_DEFAULT_WEIGHT_GRAMS=100
PANCAKE_WEBHOOK_SECRET=
# Inbound fallback makes at most one page request per resource on each interval.
PANCAKE_INBOUND_POLL_SECONDS=120
PANCAKE_INBOUND_PAGE_SIZE=25
PANCAKE_INBOUND_OVERLAP_SECONDS=120
PANCAKE_INBOUND_INITIAL_LOOKBACK_SECONDS=900
PANCAKE_INBOUND_LAG_SECONDS=10

# Order alerts + desktop Zalo automation. Keep feature flags off until secrets are configured.
TELEGRAM_ORDER_ALERTS_ENABLED=false
SPX_LABEL_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_MAX_ATTEMPTS=6
DEPLAO_ORDER_AUTOMATION_ENABLED=false
DEPLAO_DEVICE_ID=
DEPLAO_DEVICE_SECRET=
